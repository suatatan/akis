{
  "name": "akis-writer",
  "productName": "Akis",
  "version": "0.1.0",
  "description": "Akış — sakin, otomatik kaydeden Markdown yazı uygulaması",
  "author": "Akis contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader native",
    "start": "electron .",
    "test": "node --test tests/core.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:packaged": "node tests/packaged.mjs",
    "test:site": "node tests/site.mjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "playwright": "^1.58.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "lucide": "^0.468.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/lora": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0"
  },
  "build": {
    "appId": "io.akis.writer",
    "productName": "Akis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "Akis-${version}-${arch}-setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Akis.Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Akis contributors"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "Akis-${version}-${arch}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://suatatan.github.io/akis/",
  "repository": {
    "url": "https://github.com/suatatan/akis.git",
    "type": "git"
  }
}
